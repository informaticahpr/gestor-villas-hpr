:{$PORT}

encode gzip

# /api y /sanctum se reenvían al backend: para el navegador todo queda en el mismo dominio
# y así la cookie de sesión y el XSRF-TOKEN funcionan sin problemas entre sitios.
@backend path /api/* /sanctum/*
handle @backend {
	reverse_proxy {$BACKEND_URL} {
		header_up Host {upstream_hostport}
	}
}

# Todo lo demás es el sitio de Vue (history mode)
handle {
	root * /srv
	try_files {path} /index.html
	file_server
}