# En Netlify esta variable NO se lee de este archivo (que es solo la plantilla local): hay que
# definirla en Netlify > Site configuration > Environment variables, con la URL publica del
# backend (ej. https://tu-backend.up.railway.app), porque Vite la incrusta en el build al
# momento de compilar -- cambiarla despues del deploy exige un nuevo build, no solo reiniciar.
VITE_API_BASE_URL=http://localhost:8000
